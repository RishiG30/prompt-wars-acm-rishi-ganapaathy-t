# ==========================================
# FairShift Environment Configuration Template
# ==========================================
# Server Port
PORT=8080

# Environment Mode: development | test | production
NODE_ENV=development

# Industry Configuration: construction | college
ACTIVE_INDUSTRY=construction

# Data Storage Adapter: inmemory
DATA_STORE=inmemory

# JWT Session Secret
JWT_SECRET=fairshift-development-session-secret-change-in-production

# Anonymous Feedback Pepper (Salt used for one-way rate-limit hash; never logged or revealed)
FEEDBACK_SALT=fairshift-rate-limit-salt-secret-change-in-production

# Rate Limit Window (in milliseconds) & Max Requests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

